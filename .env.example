# =====================================================================
# Sales Tracker API — environment template
# Copy to `.env` (local) / `.env.prod` and fill in. Never commit a real .env.
# Every key is validated at boot (src/config/env.validation.ts).
# =====================================================================

# --- Application ------------------------------------------------------
NODE_ENV=development
PORT=4100
API_PREFIX=api
API_VERSION=v1
# Comma-separated, or * (development only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# The web app. CSV photo links point here (they must ask for a login).
APP_URL=http://localhost:5173

# --- Database (Supabase) ----------------------------------------------
# All tables live in the `sales` schema, never `public`.
# Transaction pooler (6543) — used by the running API.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (5432) — used by migrations and the seed only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=15

# --- Supabase Auth + Storage ------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings > API Keys. The new sb_publishable_ / sb_secret_ keys work, as do the legacy anon / service_role JWTs.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still signing with the legacy JWT secret; blank = verify via JWKS.
SUPABASE_JWT_SECRET=
# A PRIVATE bucket. Visit photos and project images are served via signed URLs.
SUPABASE_STORAGE_BUCKET=sales-tracker

# --- Email (Brevo) -----------------------------------------------------
# Required. The API sends every invite and reset email itself through Brevo; Supabase
# never sends mail. The link is APP_URL/set-password, so APP_URL must be the portal's
# public address and the Supabase dashboard's Site URL does not matter.
BREVO_API_KEY=
# A sender verified in Brevo (Senders, domains & dedicated IPs). Required.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Pronttera Sales

# --- Visit proof --------------------------------------------------------
# Signs the 10-minute photo window. At least 32 characters.
CAPTURE_TOKEN_SECRET=
SIGNED_URL_TTL_SECONDS=600

# --- Place names on visit photos (OpenStreetMap, free, no key) ----------
# The API looks up the area a visit photo was taken in (Nominatim, with Photon as
# a fallback), at most one request a second, cached. A failed lookup never stops a save.
GEOCODER_ENABLED=true
# Who OpenStreetMap can contact about our traffic (email or web page), as their
# usage policy asks. Sent in the User-Agent. Set it in production.
GEOCODER_CONTACT=pronttera24@gmail.com
# Leave blank for the public services; the tests point these at a local fake.
GEOCODER_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_PHOTON_URL=https://photon.komoot.io
GEOCODER_TIMEOUT_MS=4000

# --- Swagger --------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Seed (npm run db:seed) — the first Super Admin -----------------------
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
